<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Simulateur financier BVMAC pour analyser l'impact du réinvestissement des dividendes sur un portefeuille boursier de la zone CEMAC."
    />
    <title>Simulateur BVMAC | Réinvestissement des dividendes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              bvmac: {
                beige: '#F9F5F1',
                card: '#F3EDE6',
                border: '#E8DED5',
                gold: '#D4AF37',
                goldDark: '#B8860B',
                maroon: '#4A2E2B',
                maroonDeep: '#2C1614',
                maroonSoft: '#6B423D',
                text: '#2A2A2A',
                success: '#1E8E61',
                danger: '#C44536'
              }
            },
            boxShadow: {
              soft: '0 10px 25px rgba(74,46,43,0.08)'
            }
          }
        }
      };
    </script>
    <style>
      :root {
        --bvmac-beige: #F9F5F1;
        --bvmac-card: #F3EDE6;
        --bvmac-border: #E8DED5;
        --bvmac-gold: #D4AF37;
        --bvmac-gold-dark: #B8860B;
        --bvmac-maroon: #4A2E2B;
        --bvmac-maroon-deep: #2C1614;
        --bvmac-text: #2A2A2A;
      }

      html { scroll-behavior: smooth; }

      body {
        background: linear-gradient(180deg, #fffdfb 0%, #f7f1eb 100%);
        color: var(--bvmac-text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      .gold-gradient {
        background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
      }

      .maroon-gradient {
        background: linear-gradient(135deg, #4A2E2B 0%, #2C1614 100%);
      }

      .card-shadow {
        box-shadow: 0 12px 28px rgba(74, 46, 43, 0.06);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: #f2ece8; }
      ::-webkit-scrollbar-thumb {
        background: #d4af37;
        border-radius: 999px;
      }
      ::-webkit-scrollbar-thumb:hover { background: #b8860b; }

      .focus-visible:focus, button:focus-visible, input:focus-visible, select:focus-visible {
        outline: 3px solid rgba(212, 175, 55, 0.6);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body class="min-h-screen text-bvmac-text">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:text-bvmac-maroon focus:px-4 focus:py-2 focus:rounded-lg">Aller au contenu principal</a>

    <header class="maroon-gradient text-white border-b-4 border-bvmac-gold shadow-soft">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-white bg-bvmac-gold text-lg font-black text-bvmac-maroon shadow-md">
              BVMAC
            </div>
            <div>
              <h1 class="text-lg font-extrabold tracking-tight sm:text-2xl">Bourse des Valeurs Mobilières de l'Afrique Centrale</h1>
              <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-bvmac-gold">
                Plateforme régionale de cotation • Douala • CEMAC
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 rounded-lg border border-bvmac-gold/30 bg-black/15 px-3 py-2 text-xs font-medium text-white/90">
            <i class="fa-solid fa-chart-line text-bvmac-gold"></i>
            <span>Module académique & professionnel de simulation</span>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <section class="relative overflow-hidden rounded-2xl border border-bvmac-border bg-bvmac-card card-shadow p-6 sm:p-8">
        <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-bvmac-gold/15 blur-3xl"></div>
        <div class="relative z-10 space-y-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-bvmac-gold/40 bg-bvmac-gold/15 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.15em] text-bvmac-maroon">
            <i class="fa-solid fa-graduation-cap"></i>
            Modélisation financière & backtesting • 2015–2025
          </div>

          <div class="space-y-3">
            <h2 class="text-2xl font-black tracking-tight text-bvmac-maroon sm:text-4xl">
              Simulateur de stratégie de réinvestissement des dividendes à la BVMAC
            </h2>
            <p class="max-w-5xl text-sm leading-7 text-slate-700 sm:text-base">
              Analysez l'impact du réinvestissement automatique des dividendes dans un portefeuille d'actions
              de la zone CEMAC. Cette plateforme compare deux approches : une stratégie en cash et une stratégie
              DRIP (Dividend Reinvestment Plan) avec prise en compte des impôts, des frais de courtage,
              des délais d'exécution et de la dynamique de croissance des titres.
            </p>
          </div>

          <div class="grid gap-4 pt-2 md:grid-cols-3">
            <div class="rounded-xl border border-bvmac-border bg-white p-4 text-sm shadow-sm">
              <div class="mb-2 flex items-center gap-3 text-bvmac-maroon">
                <i class="fa-solid fa-shield-halved text-lg text-bvmac-gold"></i>
                <span class="font-bold">Transparence fiscale</span>
              </div>
              <p class="text-slate-600">IRCM appliqué automatiquement sur les distributions à partir de la base nette.</p>
            </div>

            <div class="rounded-xl border border-bvmac-border bg-white p-4 text-sm shadow-sm">
              <div class="mb-2 flex items-center gap-3 text-bvmac-maroon">
                <i class="fa-solid fa-coins text-lg text-bvmac-gold"></i>
                <span class="font-bold">Frais de courtage</span>
              </div>
              <p class="text-slate-600">Prise en compte des commissions réglementées sur les achats d'actions.</p>
            </div>

            <div class="rounded-xl border border-bvmac-border bg-white p-4 text-sm shadow-sm">
              <div class="mb-2 flex items-center gap-3 text-bvmac-maroon">
                <i class="fa-solid fa-cubes text-lg text-bvmac-gold"></i>
                <span class="font-bold">Discrétisation stricte</span>
              </div>
              <p class="text-slate-600">Achat d'actions entières uniquement avec conservation des reliquats en liquidités.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-8 grid gap-8 lg:grid-cols-3">
        <aside class="rounded-2xl border border-bvmac-border bg-white p-6 card-shadow">
          <div class="mb-5 flex items-center justify-between border-b border-bvmac-border pb-4">
            <h3 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
              <i class="fa-solid fa-sliders text-bvmac-gold"></i>
              Paramètres de simulation
            </h3>
            <button
              type="button"
              class="text-xs font-semibold text-bvmac-maroon underline decoration-2 underline-offset-4 transition hover:text-bvmac-gold"
              onclick="resetDefaults()"
              aria-label="Réinitialiser les valeurs par défaut"
            >
              Réinitialiser
            </button>
          </div>

          <form id="simulatorForm" class="space-y-4 text-sm" onsubmit="event.preventDefault(); runSimulation();">
            <div>
              <label for="capitalInitial" class="mb-1 block font-semibold text-slate-700">Capital initial investi (FCFA)</label>
              <div class="relative">
                <input id="capitalInitial" type="number" min="0" step="100000" value="10000000" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 pr-12 text-base font-medium text-bvmac-maroon" aria-describedby="capital-help" />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">XAF</span>
              </div>
            </div>

            <div>
              <label for="tauxIRCM" class="mb-1 block font-semibold text-slate-700">Taux d'impôt IRCM (%)</label>
              <input id="tauxIRCM" type="number" min="0" max="50" step="0.1" value="16.5" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-base font-medium text-bvmac-maroon" />
              <p class="mt-1 text-[11px] text-slate-500">Imposition libératoire à la source.</p>
            </div>

            <div>
              <label for="fraisCourtage" class="mb-1 block font-semibold text-slate-700">Frais de courtage SGI (%)</label>
              <input id="fraisCourtage" type="number" min="0" max="10" step="0.05" value="1.5" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-base font-medium text-bvmac-maroon" />
              <p class="mt-1 text-[11px] text-slate-500">Commission appliquée à chaque ordre d'achat.</p>
            </div>

            <div>
              <label for="tauxSansRisque" class="mb-1 block font-semibold text-slate-700">Taux sans risque - BTA CEMAC (%)</label>
              <input id="tauxSansRisque" type="number" min="0" max="20" step="0.1" value="4.5" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-base font-medium text-bvmac-maroon" />
            </div>

            <div>
              <label for="tauxReinvest" class="mb-1 block font-semibold text-slate-700">Taux de réinvestissement net (%)</label>
              <select id="tauxReinvest" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-base font-medium text-bvmac-maroon">
                <option value="1.0">100% (Réinvestissement total)</option>
                <option value="0.75">75% (Réinvestissement important)</option>
                <option value="0.50">50% (Réinvestissement équilibré)</option>
                <option value="0.25">25% (Réinvestissement minimal)</option>
              </select>
            </div>

            <div>
              <label for="delaiSlippage" class="mb-1 block font-semibold text-slate-700">Délai d'exécution / slippage</label>
              <select id="delaiSlippage" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-base font-medium text-bvmac-maroon">
                <option value="1">1 mois (fenêtre standard)</option>
                <option value="2">2 mois (délai moyen)</option>
                <option value="3">3 mois (inertie plus forte)</option>
              </select>
            </div>

            <button type="submit" class="gold-gradient focus-visible w-full rounded-xl px-4 py-3 font-extrabold text-bvmac-maroon shadow-md transition hover:brightness-105">
              <i class="fa-solid fa-play mr-2"></i>
              Lancer la simulation
            </button>
          </form>
        </aside>

        <section class="rounded-2xl border border-bvmac-border bg-white p-6 card-shadow lg:col-span-2">
          <div class="flex flex-col gap-3 border-b border-bvmac-border pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
                <i class="fa-solid fa-building-columns text-bvmac-gold"></i>
                Portefeuille BVMAC
              </h3>
              <p class="mt-1 text-xs text-slate-500">Action disponible selon le calendrier d'introduction historique.</p>
            </div>
            <button type="button" onclick="openStockModal()" class="inline-flex items-center gap-2 rounded-xl bg-bvmac-maroon px-3 py-2 text-xs font-bold text-bvmac-gold transition hover:bg-bvmac-maroonSoft" aria-label="Ajouter une action au portefeuille">
              <i class="fa-solid fa-plus"></i>
              Ajouter une action
            </button>
          </div>

          <div class="mt-4 overflow-x-auto">
            <table class="min-w-full border-collapse text-left text-xs">
              <thead>
                <tr class="bg-bvmac-card text-bvmac-maroon uppercase tracking-wide">
                  <th class="px-3 py-2.5 font-bold">Société</th>
                  <th class="px-3 py-2.5 font-bold">Secteur</th>
                  <th class="px-3 py-2.5 font-bold">Cours initial</th>
                  <th class="px-3 py-2.5 font-bold">Dividende brut</th>
                  <th class="px-3 py-2.5 font-bold">Croissance</th>
                  <th class="px-3 py-2.5 font-bold">Cotation</th>
                  <th class="px-3 py-2.5 text-center font-bold">Supprimer</th>
                </tr>
              </thead>
              <tbody id="stockTableBody" class="divide-y divide-bvmac-border text-slate-700"></tbody>
            </table>
          </div>

          <div class="mt-5 rounded-xl border border-bvmac-border bg-bvmac-beige p-4 text-xs">
            <p class="font-bold text-bvmac-maroon">
              <i class="fa-solid fa-circle-info mr-2 text-bvmac-gold"></i>Règle d'équipondération dynamique (1/N)
            </p>
            <p class="mt-1 text-slate-600">
              Le capital initial et les éventuels rééquilibrages sont répartis de manière égale entre les actions accessibles à la date concernée afin de limiter le biais de sélection.
            </p>
          </div>
        </section>
      </section>

      <section class="mt-8 space-y-4">
        <h3 class="flex items-center gap-2 text-xl font-black text-bvmac-maroon">
          <i class="fa-solid fa-square-poll-vertical text-bvmac-gold"></i>
          Indicateurs clés de performance et de risque
        </h3>

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-2xl border-l-4 border-bvmac-gold bg-white p-5 card-shadow">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Patrimoine final</p>
            <div id="kpiPatrimoineB" class="mt-2 text-2xl font-black text-bvmac-maroon">-- FCFA</div>
            <div class="mt-2 text-xs font-semibold text-bvmac-success">
              <i class="fa-solid fa-arrow-trend-up mr-1"></i>
              <span id="kpiSurperf">--</span> vs stratégie A
            </div>
            <p id="kpiPatrimoineA" class="mt-2 border-t border-slate-100 pt-2 text-[11px] text-slate-500">Stratégie A : -- FCFA</p>
          </article>

          <article class="rounded-2xl border-l-4 border-bvmac-maroon bg-white p-5 card-shadow">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">CAGR</p>
            <div id="kpiCAGRB" class="mt-2 text-2xl font-black text-bvmac-goldDark">-- %</div>
            <div class="mt-2 text-xs text-slate-600">
              Écart annuel net : <span id="kpiEcartCAGR" class="font-bold text-bvmac-success">-- pts</span>
            </div>
            <p id="kpiCAGRA" class="mt-2 border-t border-slate-100 pt-2 text-[11px] text-slate-500">Stratégie A : -- %</p>
          </article>

          <article class="rounded-2xl border-l-4 border-bvmac-gold bg-white p-5 card-shadow">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Ratio de Sharpe</p>
            <div id="kpiSharpeB" class="mt-2 text-2xl font-black text-bvmac-maroon">--</div>
            <div class="mt-2 text-xs font-semibold text-bvmac-success">Surperformance ajustée du risque</div>
            <p id="kpiSharpeA" class="mt-2 border-t border-slate-100 pt-2 text-[11px] text-slate-500">Stratégie A : --</p>
          </article>

          <article class="rounded-2xl border-l-4 border-red-800 bg-white p-5 card-shadow">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Max drawdown</p>
            <div id="kpiMaxDDB" class="mt-2 text-2xl font-black text-red-700">-- %</div>
            <div class="mt-2 text-xs text-slate-600">Résilience en période de choc</div>
            <p id="kpiMaxDDA" class="mt-2 border-t border-slate-100 pt-2 text-[11px] text-slate-500">Stratégie A : -- %</p>
          </article>
        </div>
      </section>

      <section class="mt-8 grid gap-8 xl:grid-cols-3">
        <div class="rounded-2xl border border-bvmac-border bg-white p-6 card-shadow xl:col-span-2">
          <div class="mb-4 flex items-center justify-between border-b border-bvmac-border pb-3">
            <h4 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
              <i class="fa-solid fa-chart-area text-bvmac-gold"></i>
              Trajectoire de richesse totale
            </h4>
            <span class="rounded-full border border-bvmac-border bg-bvmac-beige px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-bvmac-maroon">Montants en FCFA</span>
          </div>
          <div class="h-80">
            <canvas id="trajectoryChart" aria-label="Graphique de la trajectoire de richesse"></canvas>
          </div>
        </div>

        <div class="rounded-2xl border border-bvmac-border bg-white p-6 card-shadow">
          <div class="mb-4 flex items-center justify-between border-b border-bvmac-border pb-3">
            <h4 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
              <i class="fa-solid fa-chart-bar text-bvmac-gold"></i>
              Profil comparatif
            </h4>
            <span class="rounded-full border border-bvmac-border bg-bvmac-beige px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-bvmac-maroon">Sharpe & Sortino</span>
          </div>
          <div class="h-80">
            <canvas id="metricsChart" aria-label="Graphique comparatif des ratios"></canvas>
          </div>
        </div>
      </section>

      <section class="mt-8 rounded-2xl border border-bvmac-border bg-white p-6 card-shadow">
        <div class="flex flex-col gap-3 border-b border-bvmac-border pb-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
              <i class="fa-solid fa-table-list text-bvmac-gold"></i>
              Évolution chronologique annuelle détaillée
            </h3>
            <p class="mt-1 text-xs text-slate-500">Comparaison ex post des flux, des cours et de l'accumulation d'actions réinvesties.</p>
          </div>
          <button type="button" onclick="exportCSV()" class="inline-flex items-center gap-2 rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2 text-xs font-bold text-bvmac-maroon transition hover:bg-bvmac-gold hover:text-white">
            <i class="fa-solid fa-file-csv"></i>
            Exporter les données
          </button>
        </div>

        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full border-collapse text-left text-xs">
            <thead>
              <tr class="bg-bvmac-card text-bvmac-maroon uppercase tracking-wide">
                <th class="px-3 py-3 font-bold">Année</th>
                <th class="px-3 py-3 font-bold">Stratégie A</th>
                <th class="px-3 py-3 font-bold">Stratégie B</th>
                <th class="px-3 py-3 font-bold">Écart absolu</th>
                <th class="px-3 py-3 font-bold">Surperformance</th>
                <th class="px-3 py-3 font-bold">Dividendes nets</th>
                <th class="px-3 py-3 font-bold">Actions additionnelles</th>
              </tr>
            </thead>
            <tbody id="backtestTableBody" class="divide-y divide-bvmac-border text-slate-700"></tbody>
          </table>
        </div>
      </section>
    </main>

    <div id="stockModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm">
      <div class="w-full max-w-lg rounded-2xl border border-bvmac-border bg-white p-6 card-shadow">
        <div class="mb-4 flex items-center justify-between border-b border-bvmac-border pb-3">
          <h4 class="flex items-center gap-2 text-lg font-bold text-bvmac-maroon">
            <i class="fa-solid fa-plus-circle text-bvmac-gold"></i>
            Ajouter / modifier une action
          </h4>
          <button type="button" onclick="closeStockModal()" class="text-lg text-slate-400 transition hover:text-bvmac-maroon" aria-label="Fermer la fenêtre modale">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <form id="stockForm" onsubmit="event.preventDefault(); saveStock();" class="space-y-4 text-xs">
          <div>
            <label for="modalStockName" class="mb-1 block font-bold text-slate-700">Nom de la société</label>
            <input id="modalStockName" type="text" required placeholder="Ex. SODECOTON" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
          </div>

          <div>
            <label for="modalStockSector" class="mb-1 block font-bold text-slate-700">Secteur d'activité</label>
            <input id="modalStockSector" type="text" required placeholder="Ex. Agro-industrie" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="modalStockPrice" class="mb-1 block font-bold text-slate-700">Cours initial (FCFA)</label>
              <input id="modalStockPrice" type="number" required min="100" step="100" value="15000" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
            </div>
            <div>
              <label for="modalStockDiv" class="mb-1 block font-bold text-slate-700">Dividende brut (FCFA)</label>
              <input id="modalStockDiv" type="number" required min="0" step="10" value="1200" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="modalStockGrowth" class="mb-1 block font-bold text-slate-700">Croissance div. annuelle (%)</label>
              <input id="modalStockGrowth" type="number" required step="0.1" value="4.0" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
            </div>
            <div>
              <label for="modalStockYear" class="mb-1 block font-bold text-slate-700">Année d'introduction</label>
              <input id="modalStockYear" type="number" required min="2015" max="2025" value="2015" class="focus-visible w-full rounded-xl border border-bvmac-border bg-bvmac-beige px-3 py-2.5 text-sm font-medium text-bvmac-maroon" />
            </div>
          </div>

          <div class="flex justify-end gap-2 border-t border-bvmac-border pt-4">
            <button type="button" onclick="closeStockModal()" class="rounded-xl bg-slate-100 px-4 py-2 font-bold text-slate-700 transition hover:bg-slate-200">Annuler</button>
            <button type="submit" class="gold-gradient rounded-xl px-4 py-2 font-bold text-bvmac-maroon shadow-md transition hover:brightness-105">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>

    <footer class="mt-12 border-t-4 border-bvmac-gold bg-bvmac-maroon text-white">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-left">
          <div>
            <h4 class="text-base font-bold text-bvmac-gold">Bourse des Valeurs Mobilières de l'Afrique Centrale</h4>
            <p class="mt-1 text-xs text-slate-300">Siège social : Douala, Cameroun • Régulation : COSUMAF</p>
          </div>

          <div class="rounded-xl border border-bvmac-gold/40 bg-white/10 px-4 py-2 text-center text-xs text-slate-200">
            <span class="block font-bold uppercase tracking-[0.15em] text-bvmac-gold">Réalisation de FRANC THIERRY ESSANA NOMO</span>
            <span class="mt-1 block">Mémoire de Master 2 en Finance & Ingénierie Financière</span>
          </div>
        </div>

        <div class="mt-4 border-t border-white/10 pt-4 text-center text-[11px] text-slate-400">
          © 2026 BVMAC Simulator Engine • Modèle académique et professionnel de simulation de réinvestissement des dividendes.
        </div>
      </div>
    </footer>

    <script>
      const defaultStocks = [
        { id: 1, name: 'Socapalm', sector: 'Agro-industrie', price: 25000, div: 2325, growth: 5.2, startYear: 2015 },
        { id: 2, name: 'Safacam', sector: 'Agro-industrie', price: 22000, div: 2200, growth: 4.8, startYear: 2015 },
        { id: 3, name: 'SEMC', sector: 'Agroalimentaire', price: 10000, div: 600, growth: 3.5, startYear: 2015 },
        { id: 4, name: 'La Régionale', sector: 'Banque / MF', price: 42000, div: 0, growth: 0, startYear: 2021 },
        { id: 5, name: 'Bange Bank', sector: 'Secteur bancaire', price: 206000, div: 4830, growth: 2, startYear: 2022 },
        { id: 6, name: 'SCG-Ré', sector: 'Assurance', price: 12000, div: 510, growth: 6.2, startYear: 2023 }
      ];

      let stocks = [...defaultStocks];
      let trajectoryChartInstance = null;
      let metricsChartInstance = null;
      let lastSimulationResults = null;

      document.addEventListener('DOMContentLoaded', () => {
        renderStockTable();
        runSimulation();
      });

      function formatNumber(value) {
        return Number(value).toLocaleString('fr-FR');
      }

      function renderStockTable() {
        const tbody = document.getElementById('stockTableBody');
        tbody.innerHTML = '';

        stocks.forEach((stock) => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-bvmac-beige/60 transition';
          tr.innerHTML = `
            <td class="px-3 py-2.5 font-bold text-bvmac-maroon">${stock.name}</td>
            <td class="px-3 py-2.5">${stock.sector}</td>
            <td class="px-3 py-2.5 font-mono text-sm">${formatNumber(stock.price)} FCFA</td>
            <td class="px-3 py-2.5 font-mono text-sm text-emerald-700">${formatNumber(stock.div)} FCFA</td>
            <td class="px-3 py-2.5 font-mono text-sm">+${stock.growth}%</td>
            <td class="px-3 py-2.5"><span class="rounded-full bg-bvmac-gold/20 px-2 py-1 font-bold text-bvmac-maroon">${stock.startYear}</span></td>
            <td class="px-3 py-2.5 text-center">
              <button type="button" onclick="deleteStock(${stock.id})" class="text-red-600 transition hover:text-red-800" aria-label="Supprimer ${stock.name}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      function openStockModal() {
        const modal = document.getElementById('stockModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.getElementById('modalStockName').focus();
      }

      function closeStockModal() {
        const modal = document.getElementById('stockModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.getElementById('stockForm').reset();
      }

      function saveStock() {
        const name = document.getElementById('modalStockName').value.trim();
        const sector = document.getElementById('modalStockSector').value.trim();
        const price = Number(document.getElementById('modalStockPrice').value);
        const div = Number(document.getElementById('modalStockDiv').value);
        const growth = Number(document.getElementById('modalStockGrowth').value);
        const startYear = Number(document.getElementById('modalStockYear').value);

        if (!name || !sector || !Number.isFinite(price) || !Number.isFinite(div)) return;

        stocks.push({
          id: Date.now(),
          name,
          sector,
          price,
          div,
          growth,
          startYear
        });

        renderStockTable();
        closeStockModal();
        runSimulation();
      }

      function deleteStock(id) {
        if (stocks.length <= 1) {
          alert('Le portefeuille doit contenir au moins une société cotée.');
          return;
        }

        stocks = stocks.filter((stock) => stock.id !== id);
        renderStockTable();
        runSimulation();
      }

      function resetDefaults() {
        document.getElementById('capitalInitial').value = 10000000;
        document.getElementById('tauxIRCM').value = 16.5;
        document.getElementById('fraisCourtage').value = 1.5;
        document.getElementById('tauxSansRisque').value = 4.5;
        document.getElementById('tauxReinvest').value = '1.0';
        document.getElementById('delaiSlippage').value = '1';

        stocks = [...defaultStocks];
        renderStockTable();
        runSimulation();
      }

      function runSimulation() {
        const capitalInitial = Number(document.getElementById('capitalInitial').value) || 10000000;
        const ircmRate = (Number(document.getElementById('tauxIRCM').value) || 16.5) / 100;
        const feeRate = (Number(document.getElementById('fraisCourtage').value) || 1.5) / 100;
        const rfRate = (Number(document.getElementById('tauxSansRisque').value) || 4.5) / 100;
        const reinvestFactor = Number(document.getElementById('tauxReinvest').value) || 1.0;
        const slippageMonths = Number(document.getElementById('delaiSlippage').value) || 1;
        const years = [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];

        const active2015 = stocks.filter((stock) => stock.startYear <= 2015);
        const capitalPerStock = active2015.length > 0 ? capitalInitial / active2015.length : capitalInitial;

        let stratA_cash = 0;
        let stratA_shares = {};
        let stratB_cash = 0;
        let stratB_shares = {};

        stocks.forEach((stock) => {
          if (stock.startYear <= 2015) {
            const qtyA = Math.floor(capitalPerStock / (stock.price * (1 + feeRate)));
            stratA_shares[stock.id] = qtyA;
            stratA_cash += capitalPerStock - qtyA * stock.price * (1 + feeRate);

            const qtyB = Math.floor(capitalPerStock / (stock.price * (1 + feeRate)));
            stratB_shares[stock.id] = qtyB;
            stratB_cash += capitalPerStock - qtyB * stock.price * (1 + feeRate);
          } else {
            stratA_shares[stock.id] = 0;
            stratB_shares[stock.id] = 0;
          }
        });

        const historyData = [];

        years.forEach((year) => {
          const newlyListed = stocks.filter((stock) => stock.startYear === year && year > 2015);

          if (newlyListed.length > 0) {
            newlyListed.forEach((stock) => {
              const price = stock.price * Math.pow(1 + stock.growth / 100, year - stock.startYear);
              if (stratB_cash > price * (1 + feeRate)) {
                const addQty = Math.floor((stratB_cash * 0.4) / (price * (1 + feeRate)));
                stratB_shares[stock.id] = (stratB_shares[stock.id] || 0) + addQty;
                stratB_cash -= addQty * price * (1 + feeRate);
              }
            });
          }

          let yrDivNetStratA = 0;
          let yrDivNetStratB = 0;
          let totalNewSharesBought = 0;

          stocks.forEach((stock) => {
            if (stock.startYear <= year) {
              const currentDivGross = stock.div * Math.pow(1 + stock.growth / 100, year - stock.startYear);
              const currentDivNet = currentDivGross * (1 - ircmRate);

              yrDivNetStratA += (stratA_shares[stock.id] || 0) * currentDivNet;
              yrDivNetStratB += (stratB_shares[stock.id] || 0) * currentDivNet;
            }
          });

          stratA_cash += yrDivNetStratA;

          const availableForReinvest = (stratB_cash + yrDivNetStratB) * reinvestFactor;
          const remainingUninvested = (stratB_cash + yrDivNetStratB) * (1 - reinvestFactor);
          const activeDividendStocks = stocks.filter((stock) => stock.startYear <= year && stock.div > 0);

          if (activeDividendStocks.length > 0 && availableForReinvest > 0) {
            const poolPerStock = availableForReinvest / activeDividendStocks.length;
            let spentB = 0;

            activeDividendStocks.forEach((stock) => {
              const currentPrice = stock.price * Math.pow(1 + (stock.growth * 0.8) / 100, year - stock.startYear);
              const adjustedPrice = currentPrice * (1 + slippageMonths * 0.003);
              const newShares = Math.floor(poolPerStock / (adjustedPrice * (1 + feeRate)));

              if (newShares > 0) {
                stratB_shares[stock.id] = (stratB_shares[stock.id] || 0) + newShares;
                totalNewSharesBought += newShares;
                spentB += newShares * adjustedPrice * (1 + feeRate);
              }
            });

            stratB_cash = (availableForReinvest - spentB) + remainingUninvested;
          } else {
            stratB_cash += yrDivNetStratB;
          }

          let valA_equities = 0;
          let valB_equities = 0;

          stocks.forEach((stock) => {
            if (stock.startYear <= year) {
              const currentPrice = stock.price * Math.pow(1 + (stock.growth * 0.8) / 100, year - stock.startYear);
              valA_equities += (stratA_shares[stock.id] || 0) * currentPrice;
              valB_equities += (stratB_shares[stock.id] || 0) * currentPrice;
            }
          });

          const totalWealthA = valA_equities + stratA_cash;
          const totalWealthB = valB_equities + stratB_cash;
          const diffAbs = totalWealthB - totalWealthA;
          const surperf = ((totalWealthB / totalWealthA) - 1) * 100;

          historyData.push({
            year,
            wealthA: Math.round(totalWealthA),
            wealthB: Math.round(totalWealthB),
            diffAbs: Math.round(diffAbs),
            surperf: Number(surperf).toFixed(2),
            divNetB: Math.round(yrDivNetStratB),
            newSharesB: totalNewSharesBought
          });
        });

        const nYears = years.length;
        const finalA = historyData[historyData.length - 1].wealthA;
        const finalB = historyData[historyData.length - 1].wealthB;

        const cagrA = (Math.pow(finalA / capitalInitial, 1 / nYears) - 1) * 100;
        const cagrB = (Math.pow(finalB / capitalInitial, 1 / nYears) - 1) * 100;

        const returnsA = [];
        const returnsB = [];
        for (let i = 1; i < historyData.length; i++) {
          returnsA.push(historyData[i].wealthA / historyData[i - 1].wealthA - 1);
          returnsB.push(historyData[i].wealthB / historyData[i - 1].wealthB - 1);
        }

        const meanA = returnsA.reduce((sum, value) => sum + value, 0) / returnsA.length;
        const meanB = returnsB.reduce((sum, value) => sum + value, 0) / returnsB.length;

        const volA = Math.sqrt(returnsA.reduce((sum, value) => sum + Math.pow(value - meanA, 2), 0) / (returnsA.length - 1)) * 100;
        const volB = Math.sqrt(returnsB.reduce((sum, value) => sum + Math.pow(value - meanB, 2), 0) / (returnsB.length - 1)) * 100;

        const sharpeA = ((cagrA / 100) - rfRate) / (volA / 100 || 1);
        const sharpeB = ((cagrB / 100) - rfRate) / (volB / 100 || 1);

        const downsideA = Math.sqrt(returnsA.filter((r) => r < rfRate).reduce((sum, value) => sum + Math.pow(value - rfRate, 2), 0) / returnsA.length) * 100 || 1;
        const downsideB = Math.sqrt(returnsB.filter((r) => r < rfRate).reduce((sum, value) => sum + Math.pow(value - rfRate, 2), 0) / returnsB.length) * 100 || 1;

        const sortinoA = ((cagrA / 100) - rfRate) / (downsideA / 100 || 1);
        const sortinoB = ((cagrB / 100) - rfRate) / (downsideB / 100 || 1);

        function calcMaxDD(historyKey) {
          let peak = historyData[0][historyKey];
          let maxDD = 0;

          historyData.forEach((item) => {
            if (item[historyKey] > peak) peak = item[historyKey];
            const dd = (peak - item[historyKey]) / peak;
            if (dd > maxDD) maxDD = dd;
          });

          return maxDD * 100;
        }

        const maxDDA = calcMaxDD('wealthA');
        const maxDDB = calcMaxDD('wealthB');

        lastSimulationResults = {
          historyData,
          finalA,
          finalB,
          cagrA,
          cagrB,
          sharpeA,
          sharpeB,
          sortinoA,
          sortinoB,
          maxDDA,
          maxDDB
        };

        updateDashboardUI(lastSimulationResults);
      }

      function updateDashboardUI(res) {
        document.getElementById('kpiPatrimoineB').textContent = `${formatNumber(res.finalB)} FCFA`;
        document.getElementById('kpiPatrimoineA').textContent = `Stratégie A : ${formatNumber(res.finalA)} FCFA`;

        const surperfPct = ((res.finalB / res.finalA - 1) * 100).toFixed(2);
        document.getElementById('kpiSurperf').textContent = `${Number(surperfPct) >= 0 ? '+' : ''}${surperfPct}%`;

        document.getElementById('kpiCAGRB').textContent = `${res.cagrB.toFixed(2)} %`;
        document.getElementById('kpiCAGRA').textContent = `Stratégie A : ${res.cagrA.toFixed(2)} %`;
        document.getElementById('kpiEcartCAGR').textContent = `${(res.cagrB - res.cagrA) >= 0 ? '+' : ''}${(res.cagrB - res.cagrA).toFixed(2)} pts`;

        document.getElementById('kpiSharpeB').textContent = res.sharpeB.toFixed(2);
        document.getElementById('kpiSharpeA').textContent = `Stratégie A : ${res.sharpeA.toFixed(2)}`;

        document.getElementById('kpiMaxDDB').textContent = `${-res.maxDDB.toFixed(2)} %`;
        document.getElementById('kpiMaxDDA').textContent = `Stratégie A : ${-res.maxDDA.toFixed(2)} %`;

        const tbody = document.getElementById('backtestTableBody');
        tbody.innerHTML = '';

        res.historyData.forEach((entry) => {
          const row = document.createElement('tr');
          row.className = 'hover:bg-bvmac-beige/60 transition';
          row.innerHTML = `
            <td class="px-3 py-3 font-bold text-bvmac-maroon">${entry.year}</td>
            <td class="px-3 py-3 font-mono">${formatNumber(entry.wealthA)} FCFA</td>
            <td class="px-3 py-3 font-mono font-bold text-bvmac-maroon">${formatNumber(entry.wealthB)} FCFA</td>
            <td class="px-3 py-3 font-mono font-bold ${entry.diffAbs >= 0 ? 'text-emerald-700' : 'text-red-600'}">${entry.diffAbs >= 0 ? '+' : ''}${formatNumber(entry.diffAbs)} FCFA</td>
            <td class="px-3 py-3 font-bold"><span class="rounded-full ${Number(entry.surperf) >= 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-700'} px-2 py-1 text-[11px]">${Number(entry.surperf) >= 0 ? '+' : ''}${entry.surperf}%</span></td>
            <td class="px-3 py-3 font-mono text-slate-600">${formatNumber(entry.divNetB)} FCFA</td>
            <td class="px-3 py-3 font-mono text-center font-bold text-bvmac-goldDark">+${formatNumber(entry.newSharesB)}</td>
          `;
          tbody.appendChild(row);
        });

        const ctxLine = document.getElementById('trajectoryChart').getContext('2d');
        if (trajectoryChartInstance) trajectoryChartInstance.destroy();

        trajectoryChartInstance = new Chart(ctxLine, {
          type: 'line',
          data: {
            labels: res.historyData.map((item) => item.year),
            datasets: [
              {
                label: 'Stratégie B (DRIP)',
                data: res.historyData.map((item) => item.wealthB),
                borderColor: '#D4AF37',
                backgroundColor: 'rgba(212,175,55,0.12)',
                borderWidth: 3,
                fill: true,
                tension: 0.35
              },
              {
                label: 'Stratégie A (Cash)',
                data: res.historyData.map((item) => item.wealthA),
                borderColor: '#4A2E2B',
                backgroundColor: 'transparent',
                borderWidth: 2,
                borderDash: [6, 6],
                tension: 0.35
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { position: 'bottom' } },
            scales: {
              y: {
                ticks: {
                  callback: (value) => `${(value / 1000000).toFixed(1)}M FCFA`
                }
              }
            }
          }
        });

        const ctxBar = document.getElementById('metricsChart').getContext('2d');
        if (metricsChartInstance) metricsChartInstance.destroy();

        metricsChartInstance = new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: ['Sharpe', 'Sortino'],
            datasets: [
              {
                label: 'Stratégie B',
                data: [res.sharpeB, res.sortinoB],
                backgroundColor: '#D4AF37'
              },
              {
                label: 'Stratégie A',
                data: [res.sharpeA, res.sortinoA],
                backgroundColor: '#4A2E2B'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } },
            scales: {
              y: { beginAtZero: false }
            }
          }
        });
      }

      function exportCSV() {
        if (!lastSimulationResults) return;

        const rows = [
          ['Annee', 'Strategie_A_FCFA', 'Strategie_B_FCFA', 'Ecart_Absolu_FCFA', 'Surperformance_Pct', 'Dividendes_Nets_B_FCFA', 'Actions_Nouvelles_B']
        ];

        lastSimulationResults.historyData.forEach((entry) => {
          rows.push([
            entry.year,
            entry.wealthA,
            entry.wealthB,
            entry.diffAbs,
            entry.surperf,
            entry.divNetB,
            entry.newSharesB
          ]);
        });

        const csvContent = rows.map((row) => row.join(',')).join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'Backtest_BVMAC_Dividendes.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      }
    </script>
